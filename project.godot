; Cast & Crank Gate 1
; Godot 4.7.1
config_version=5

[admob]
general/ios/enabled=false

[application]
config/name="Cast & Crank"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

[display/window]
size/viewport_width=720
size/viewport_height=1280
size/window_width_override=360
size/window_height_override=640
stretch/mode="canvas_items"
handheld/orientation=1

[editor_plugins]
enabled=PackedStringArray("res://addons/admob/plugin.cfg")

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]
cast_fallback={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
hook_fallback={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":72)]
}
reel_fallback={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":82)]
}

[input_devices]
sensors/enable_accelerometer=true
sensors/enable_gravity=true
sensors/enable_gyroscope=true

[android]
package/unique_name="com.tak.castandcrank"
package/name="CastAndCrank"
package/signed=false
gesture/swipe_to_dismiss=false
